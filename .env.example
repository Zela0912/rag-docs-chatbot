# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Models (prices checked 2026-11-05 on developers.openai.com/api/docs/pricing)
CHAT_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning
TOP_K=5
MIN_SCORE=0.3
HYBRID_SEARCH=true
MAX_OUTPUT_TOKENS=1000

PRODUCT_NAME=TidyShift
PORT=3001

# Abuse protection for a public demo
RATE_LIMIT_PER_MINUTE=20
# Set to 1 behind a single reverse proxy (Render, Fly.io, Railway) so rate limits see real client IPs
TRUST_PROXY=0
